<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>CellCascade.Benchmarks</RootNamespace>
    <!-- BenchmarkDotNet needs the benchmark classes and methods public, and it runs Release builds only. -->
    <NoWarn>$(NoWarn);CA1515;CA1822</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CellCascade\CellCascade.csproj" />
  </ItemGroup>

</Project>
